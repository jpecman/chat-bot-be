# Copy to .env and fill in. Never commit .env.
APP_NAME="Book Chatbot API"
# JSON list
CORS_ORIGINS=["http://localhost:5173"]
# Number of top chunks to retrieve (each is widened with its neighbours)
RETRIEVER_K=5

# Azure OpenAI (chat)
AZURE_OPENAI__ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI__API_KEY=<your-api-key>
AZURE_OPENAI__API_VERSION=2024-10-21
AZURE_OPENAI__CHAT_DEPLOYMENT=gpt-4.1-mini
# Not used (embeddings come from Ollama), but still required by the settings
AZURE_OPENAI__EMBEDDING_DEPLOYMENT=unused

# Ollama (embeddings) - must be the same model used at ingestion
OLLAMA__BASE_URL=http://localhost:11434
OLLAMA__EMBEDDING_MODEL=qwen3-embedding:4b

# Qdrant - existing collection, this app does not ingest
QDRANT__URL=http://localhost:6333
# QDRANT__API_KEY=<your-api-key>
QDRANT__COLLECTION=books_<embedder>_<model>_c<chunk-size>_o<overlap>
